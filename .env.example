# Copy to .env to override config/config.yaml without editing it.
# Every key is optional; leave a line commented to keep the value from the YAML.
# Precedence: config/config.yaml < .env < process environment < command-line flags.
# Relative paths are resolved against the project root.

# Config file to load
# TPD_CONFIG=config/config.yaml

# Video source: phone | webcam | video   (--source)
# TPD_SOURCE=phone

# Android IP camera stream URL   (--url)
# TPD_PHONE_URL=http://192.0.0.4:8080/video

# Webcam index   (--camera-index)
# TPD_CAMERA_INDEX=0

# Recorded video file (.mp4/.avi/.mov/.mkv)   (--path)
# TPD_VIDEO_PATH=data/videos/bus_video.mp4

# YOLO weights   (--model)
# TPD_MODEL_PATH=models/yolov8n.pt

# Inference device: cpu | auto | cuda:N   (--device)
# TPD_DEVICE=cpu

# The single SQLite database used by detection, ticket checks, dashboard and demo data   (--db)
# TPD_DB_PATH=data/ticketless.db

# DEBUG | INFO | WARNING | ERROR   (--log-level)
# TPD_LOG_LEVEL=INFO

# Current station for ticket checks; must be on the route, or none to skip station checks   (--station)
# TPD_CURRENT_STATION=City Hospital
